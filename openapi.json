    "/accelerator": {
      "post": {
        "summary": "Submit Bitcoin transaction",
        "description": "Not available until the accelerator backend is connected. Requires accelerator permission. Accepted submission is not confirmation.",
        "operationId": "accelerator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "txid"
                ],
                "properties": {
                  "txid": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$",
                    "description": "Bitcoin transaction ID."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Transaction submission accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "txid": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "submitted"
                          ]
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Disabled account or feature permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Data not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 2 KB"
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
