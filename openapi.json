    "/coins": {
      "get": {
        "summary": "Coin market list",
        "description": "Paginated locally stored market data. Meta includes page, limit and has_more.",
        "operationId": "coinlist",
        "parameters": [
          {
            "name": "fiat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Configured fiat currency, e.g. USD. Unsupported values fall back to the configured default."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number; default 1."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 100
            },
            "description": "Items per page, default 100; values are clamped to 1–250."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search the stored coin names and symbols."
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "market_cap_desc",
                "market_cap_asc",
                "volume_desc",
                "price_desc",
                "price_asc",
                "change_desc",
                "change_asc"
              ]
            },
            "description": "Sort order; default market_cap_desc."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CoinList"
                    },
